// =============================================================================
// Identity & Access — User, Role, Permission, Session
// =============================================================================

/// Application login account. May link to one Employee record.
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  companyId           String?    @map("company_id") @db.Uuid
  email               String     @unique @db.VarChar(255)
  passwordHash        String?    @map("password_hash") @db.VarChar(255)
  name                String     @db.VarChar(255)
  phone               String?    @db.VarChar(20)
  avatarFileId        String?    @map("avatar_file_id") @db.Uuid
  status              UserStatus @default(active)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz
  twoFactorEnabled    Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?    @map("two_factor_secret") @db.VarChar(255)
  emailVerified       DateTime?  @map("email_verified") @db.Timestamptz
  remarks             String?    @db.Text
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  createdBy           String?    @map("created_by") @db.Uuid
  updatedBy           String?    @map("updated_by") @db.Uuid
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz
  deletedBy           String?    @map("deleted_by") @db.Uuid
  version             Int        @default(1)

  company        Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee       Employee?
  userRoles      UserRole[]
  sessions       Session[]
  accounts       Account[]
  loginHistories LoginHistory[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  activityLogs   ActivityLog[]
  passwordResetTokens PasswordResetToken[]
  invitations           UserInvitation[]
  pendingTwoFactorAuths PendingTwoFactorAuth[]
  recoveryCodes         UserRecoveryCode[]
  devices               UserDevice[]
  passwordHistories     PasswordHistory[]
  securityEvents        SecurityEvent[]
  managedBranches       Branch[]               @relation("BranchManager")

  @@index([companyId], map: "idx_users_company_id")
  @@index([email], map: "idx_users_email")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

/// RBAC role — system or company-scoped.
model Role {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String?         @map("company_id") @db.Uuid
  name        String          @db.VarChar(100)
  slug        String          @db.VarChar(100)
  description String?         @db.Text
  isSystem    Boolean         @default(false) @map("is_system")
  scope       PermissionScope @default(company)
  status      RecordStatus    @default(active)
  remarks     String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?         @map("created_by") @db.Uuid
  updatedBy   String?         @map("updated_by") @db.Uuid
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz
  deletedBy   String?         @map("deleted_by") @db.Uuid
  version     Int             @default(1)

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, slug], map: "uq_roles_company_slug")
  @@index([companyId], map: "idx_roles_company_id")
  @@map("roles")
}

/// Atomic permission key: module.resource.action
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String   @db.VarChar(50)
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  key         String   @unique @db.VarChar(200)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@index([module], map: "idx_permissions_module")
  @@map("permissions")
}

/// Junction: Role ↔ Permission
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Junction: User ↔ Role with optional branch scope
model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  assignedBy String?  @map("assigned_by") @db.Uuid

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, branchId], map: "uq_user_roles_user_role_branch")
  @@index([userId], map: "idx_user_roles_user_id")
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

/// Auth.js compatible database session store.
model Session {
  id             String   @id @default(uuid()) @db.Uuid
  sessionToken   String   @unique @map("session_token") @db.VarChar(255)
  userId         String   @map("user_id") @db.Uuid
  expires        DateTime @db.Timestamptz
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.Text
  deviceLabel    String?  @map("device_label") @db.VarChar(255)
  deviceId       String?  @map("device_id") @db.Uuid
  location       String?  @db.VarChar(255)
  isTrusted      Boolean  @default(false) @map("is_trusted")
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expires], map: "idx_sessions_expires")
  @@index([deviceId], map: "idx_sessions_device_id")
  @@map("sessions")
}

/// Auth.js OAuth account linkage (future providers).
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(50)
  providerAccountId String  @map("provider_account_id") @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @map("token_type") @db.VarChar(50)
  scope             String? @db.VarChar(255)
  id_token          String? @db.Text
  session_state     String? @map("session_state") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], map: "uq_accounts_provider_account")
  @@index([userId], map: "idx_accounts_user_id")
  @@map("accounts")
}

/// Auth.js email verification tokens.
model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token], map: "uq_verification_tokens_identifier_token")
  @@map("verification_tokens")
}

/// Password reset tokens with expiry and single-use tracking.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expires   DateTime  @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@index([expires], map: "idx_password_reset_tokens_expires")
  @@map("password_reset_tokens")
}

/// User invitation tokens for admin-initiated onboarding.
model UserInvitation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique @db.VarChar(255)
  expires    DateTime  @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  invitedBy  String?   @map("invited_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_invitations_user_id")
  @@index([expires], map: "idx_user_invitations_expires")
  @@map("user_invitations")
}

/// Immutable login attempt history for security auditing.
model LoginHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  email         String   @db.VarChar(255)
  success       Boolean
  failureReason String?  @map("failure_reason") @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  browser       String?  @db.VarChar(100)
  os            String?  @db.VarChar(100)
  deviceLabel   String?  @map("device_label") @db.VarChar(255)
  location      String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_login_histories_user_id")
  @@index([email], map: "idx_login_histories_email")
  @@index([createdAt(sort: Desc)], map: "idx_login_histories_created_at")
  @@map("login_histories")
}
