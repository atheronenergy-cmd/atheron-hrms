// =============================================================================
// Assets, Expenses, Recruitment, Training, Performance
// =============================================================================

model Asset {
  id           String      @id @default(uuid()) @db.Uuid
  companyId    String      @map("company_id") @db.Uuid
  name         String      @db.VarChar(255)
  code         String      @db.VarChar(50)
  category     String      @db.VarChar(100)
  serialNumber String?     @map("serial_number") @db.VarChar(100)
  purchaseDate DateTime?   @map("purchase_date") @db.Date
  purchaseCost Decimal?    @map("purchase_cost") @db.Decimal(15, 2)
  status       AssetStatus @default(available)
  metadata     Json        @default("{}")
  remarks      String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String?     @map("created_by") @db.Uuid
  updatedBy    String?     @map("updated_by") @db.Uuid
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz
  deletedBy    String?     @map("deleted_by") @db.Uuid
  version      Int         @default(1)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assetAssignments AssetAssignment[]

  @@unique([companyId, code], map: "uq_assets_company_code")
  @@index([companyId], map: "idx_assets_company_id")
  @@index([status], map: "idx_assets_status")
  @@map("assets")
}

model AssetAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  assetId    String    @map("asset_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  returnedAt DateTime? @map("returned_at") @db.Timestamptz
  condition  String?   @db.VarChar(255)
  remarks    String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  version    Int       @default(1)

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([assetId], map: "idx_asset_assignments_asset_id")
  @@index([employeeId], map: "idx_asset_assignments_employee_id")
  @@map("asset_assignments")
}

model ExpenseCategory {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  name      String       @db.VarChar(100)
  code      String       @db.VarChar(50)
  maxAmount Decimal?     @map("max_amount") @db.Decimal(15, 2)
  status    RecordStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  version   Int          @default(1)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  expenses Expense[]

  @@unique([companyId, code], map: "uq_expense_categories_company_code")
  @@map("expense_categories")
}

model Expense {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @map("company_id") @db.Uuid
  employeeId        String        @map("employee_id") @db.Uuid
  expenseCategoryId String        @map("expense_category_id") @db.Uuid
  title             String        @db.VarChar(255)
  amount            Decimal       @db.Decimal(15, 2)
  expenseDate       DateTime      @map("expense_date") @db.Date
  status            ExpenseStatus @default(draft)
  receiptFileId     String?       @map("receipt_file_id") @db.Uuid
  approvedBy        String?       @map("approved_by") @db.Uuid
  approvedAt        DateTime?     @map("approved_at") @db.Timestamptz
  remarks           String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  createdBy         String?       @map("created_by") @db.Uuid
  version           Int           @default(1)

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)

  @@index([employeeId], map: "idx_expenses_employee_id")
  @@index([companyId, status], map: "idx_expenses_company_status")
  @@map("expenses")
}

model Recruitment {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  departmentId String?           @map("department_id") @db.Uuid
  title        String            @db.VarChar(255)
  code         String            @db.VarChar(50)
  description  String?           @db.Text
  openings     Int               @default(1)
  status       RecruitmentStatus @default(draft)
  publishedAt  DateTime?         @map("published_at") @db.Timestamptz
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz
  remarks      String?           @db.Text
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String?           @map("created_by") @db.Uuid
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz
  version      Int               @default(1)

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  candidates Candidate[]

  @@unique([companyId, code], map: "uq_recruitments_company_code")
  @@index([companyId, status], map: "idx_recruitments_company_status")
  @@map("recruitments")
}

model Candidate {
  id            String          @id @default(uuid()) @db.Uuid
  recruitmentId String          @map("recruitment_id") @db.Uuid
  firstName     String          @map("first_name") @db.VarChar(100)
  lastName      String          @map("last_name") @db.VarChar(100)
  email         String          @db.VarChar(255)
  phone         String?         @db.VarChar(20)
  resumeFileId  String?         @map("resume_file_id") @db.Uuid
  status        CandidateStatus @default(applied)
  source        String?         @db.VarChar(100)
  remarks       String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  version       Int             @default(1)

  recruitment Recruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  interviews  Interview[]

  @@index([recruitmentId], map: "idx_candidates_recruitment_id")
  @@index([email], map: "idx_candidates_email")
  @@map("candidates")
}

model Interview {
  id              String          @id @default(uuid()) @db.Uuid
  candidateId     String          @map("candidate_id") @db.Uuid
  interviewerId   String?         @map("interviewer_id") @db.Uuid
  scheduledAt     DateTime        @map("scheduled_at") @db.Timestamptz
  durationMinutes Int             @default(60) @map("duration_minutes")
  location        String?         @db.VarChar(255)
  status          InterviewStatus @default(scheduled)
  feedback        String?         @db.Text
  rating          Int?            @db.SmallInt
  remarks         String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  version         Int             @default(1)

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer Employee? @relation(fields: [interviewerId], references: [id], onDelete: SetNull)

  @@index([candidateId], map: "idx_interviews_candidate_id")
  @@index([scheduledAt], map: "idx_interviews_scheduled_at")
  @@map("interviews")
}

model Training {
  id                String         @id @default(uuid()) @db.Uuid
  employeeId        String         @map("employee_id") @db.Uuid
  title             String         @db.VarChar(255)
  provider          String?        @db.VarChar(255)
  startDate         DateTime       @map("start_date") @db.Date
  endDate           DateTime?      @map("end_date") @db.Date
  status            TrainingStatus @default(draft)
  certificateFileId String?        @map("certificate_file_id") @db.Uuid
  remarks           String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  createdBy         String?        @map("created_by") @db.Uuid
  version           Int            @default(1)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "idx_trainings_employee_id")
  @@map("trainings")
}

model PerformanceReview {
  id            String                  @id @default(uuid()) @db.Uuid
  employeeId    String                  @map("employee_id") @db.Uuid
  reviewerId    String?                 @map("reviewer_id") @db.Uuid
  cycleName     String                  @map("cycle_name") @db.VarChar(100)
  periodStart   DateTime                @map("period_start") @db.Date
  periodEnd     DateTime                @map("period_end") @db.Date
  status        PerformanceReviewStatus @default(draft)
  overallRating Decimal?                @map("overall_rating") @db.Decimal(3, 2)
  goals         Json                    @default("[]")
  feedback      String?                 @db.Text
  remarks       String?                 @db.Text
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  createdBy     String?                 @map("created_by") @db.Uuid
  version       Int                     @default(1)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "idx_performance_reviews_employee_id")
  @@map("performance_reviews")
}
