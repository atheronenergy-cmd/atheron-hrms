model ProductionMetric {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  metricDate      DateTime @map("metric_date") @db.Date
  kpiCode         String   @map("kpi_code") @db.VarChar(50)
  kpiName         String   @map("kpi_name") @db.VarChar(100)
  targetValue     Decimal  @default(0) @map("target_value") @db.Decimal(15, 2)
  actualValue     Decimal  @default(0) @map("actual_value") @db.Decimal(15, 2)
  qualityScore    Decimal? @map("quality_score") @db.Decimal(8, 4)
  rejectPercent   Decimal? @map("reject_percent") @db.Decimal(8, 4)
  efficiencyScore Decimal? @map("efficiency_score") @db.Decimal(8, 4)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?  @map("created_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, metricDate], map: "idx_production_metrics_employee_date")
  @@index([companyId, kpiCode], map: "idx_production_metrics_company_kpi")
  @@map("production_metrics")
}

