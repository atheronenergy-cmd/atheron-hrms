model OvertimeRule {
  id                 String                  @id @default(uuid()) @db.Uuid
  companyId          String                  @map("company_id") @db.Uuid
  name               String                  @db.VarChar(100)
  code               String                  @db.VarChar(50)
  overtimeType       OvertimeType            @default(hourly) @map("overtime_type")
  scope              EarningsRuleScope       @default(company)
  branchId           String?                 @map("branch_id") @db.Uuid
  departmentId       String?                 @map("department_id") @db.Uuid
  designationId      String?                 @map("designation_id") @db.Uuid
  employeeId         String?                 @map("employee_id") @db.Uuid
  calculationMode    EarningsCalculationMode @default(fixed) @map("calculation_mode")
  hourlyRate         Decimal?                @map("hourly_rate") @db.Decimal(15, 2)
  multiplier         Decimal                 @default(1) @db.Decimal(8, 4)
  minHours           Decimal?                @map("min_hours") @db.Decimal(8, 2)
  maxHours           Decimal?                @map("max_hours") @db.Decimal(8, 2)
  approvalRequired   Boolean                 @default(true) @map("approval_required")
  autoCalculation    Boolean                 @default(true) @map("auto_calculation")
  formulaExpression  String?                 @map("formula_expression") @db.Text
  conditions         Json                    @default("{}")
  effectiveFrom      DateTime                @map("effective_from") @db.Date
  effectiveTo        DateTime?               @map("effective_to") @db.Date
  versionNumber      Int                     @default(1) @map("version_number")
  status             RecordStatus            @default(active)
  remarks            String?                 @db.Text
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?                 @map("created_by") @db.Uuid
  updatedBy          String?                 @map("updated_by") @db.Uuid
  deletedAt          DateTime?               @map("deleted_at") @db.Timestamptz
  version            Int                     @default(1)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  records  OvertimeRecord[]

  @@unique([companyId, code, versionNumber], map: "uq_overtime_rules_company_code_version")
  @@index([companyId, scope], map: "idx_overtime_rules_company_scope")
  @@map("overtime_rules")
}

model OvertimeRecord {
  id                   String               @id @default(uuid()) @db.Uuid
  companyId            String               @map("company_id") @db.Uuid
  employeeId           String               @map("employee_id") @db.Uuid
  overtimeRuleId       String?              @map("overtime_rule_id") @db.Uuid
  payrollCalculationId String?              @unique @map("payroll_calculation_id") @db.Uuid
  periodStart          DateTime             @map("period_start") @db.Date
  periodEnd            DateTime             @map("period_end") @db.Date
  overtimeType         OvertimeType         @default(hourly) @map("overtime_type")
  normalHours          Decimal              @default(0) @map("normal_hours") @db.Decimal(8, 2)
  otHours              Decimal              @default(0) @map("ot_hours") @db.Decimal(8, 2)
  holidayOtHours       Decimal              @default(0) @map("holiday_ot_hours") @db.Decimal(8, 2)
  nightOtHours         Decimal              @default(0) @map("night_ot_hours") @db.Decimal(8, 2)
  hourlyRate           Decimal              @default(0) @map("hourly_rate") @db.Decimal(15, 2)
  multiplier           Decimal              @default(1) @db.Decimal(8, 4)
  amount               Decimal              @default(0) @db.Decimal(15, 2)
  status               OvertimeRecordStatus @default(draft)
  metadata             Json                 @default("{}")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  createdBy            String?              @map("created_by") @db.Uuid
  updatedBy            String?              @map("updated_by") @db.Uuid
  deletedAt            DateTime?            @map("deleted_at") @db.Timestamptz
  version              Int                  @default(1)

  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  overtimeRule       OvertimeRule?       @relation(fields: [overtimeRuleId], references: [id], onDelete: SetNull)
  payrollCalculation PayrollCalculation? @relation(fields: [payrollCalculationId], references: [id], onDelete: SetNull)
  approvals          OvertimeApproval[]

  @@index([employeeId, periodStart], map: "idx_overtime_records_employee_period")
  @@index([companyId, status], map: "idx_overtime_records_company_status")
  @@map("overtime_records")
}

model OvertimeApproval {
  id               String                 @id @default(uuid()) @db.Uuid
  companyId        String                 @map("company_id") @db.Uuid
  overtimeRecordId String                 @map("overtime_record_id") @db.Uuid
  approvalLevel    String                 @map("approval_level") @db.VarChar(30)
  status           EarningsApprovalStatus @default(submitted)
  approverUserId   String?                @map("approver_user_id") @db.Uuid
  approvedAt       DateTime?              @map("approved_at") @db.Timestamptz
  remarks          String?                @db.Text
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz

  overtimeRecord OvertimeRecord @relation(fields: [overtimeRecordId], references: [id], onDelete: Cascade)

  @@index([overtimeRecordId], map: "idx_overtime_approvals_record")
  @@map("overtime_approvals")
}

